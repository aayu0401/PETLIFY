# ==========================================
# Root .gitignore for PETLIFY (Web & Mobile)
# ==========================================

# Node / Web
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
app.*.symbols
app.*.map.json

# Android Studio / Xcode build artifacts
/android/app/debug/
/android/app/profile/
/android/app/release/
*.apk
*.aab

# OS & IDE
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json

# Environment & Secrets
.env
.env.local
.env.*.local
*.log
logs/
